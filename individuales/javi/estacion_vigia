#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Estructura de datos para un evento de sensor
typedef struct Evento {
    char tipoSensor[30];
    float valor;
    char marcaTiempo[25]; // Formato "YYYY-MM-DD HH:MM:SS"
} Evento;

// Nodo para la lista enlazada
typedef struct NodoEvento {
    Evento evento;
    struct NodoEvento *sig;
} NodoEvento;

// Registra un evento en la lista enlazada
void registrarEvento(NodoEvento **head, const char *sensor, float valor, const char *timestamp) {
    NodoEvento *nuevo = (NodoEvento *)malloc(sizeof(NodoEvento));
    if (nuevo == NULL) {
        printf("Error: No se pudo asignar memoria dinámicamente.\n");
        return;
    }

    strncpy(nuevo->evento.tipoSensor, sensor, sizeof(nuevo->evento.tipoSensor) - 1);
    nuevo->evento.tipoSensor[sizeof(nuevo->evento.tipoSensor) - 1] = '\0';
    
    nuevo->evento.valor = valor;
    
    strncpy(nuevo->evento.marcaTiempo, timestamp, sizeof(nuevo->evento.marcaTiempo) - 1);
    nuevo->evento.marcaTiempo[sizeof(nuevo->evento.marcaTiempo) - 1] = '\0';

    nuevo->sig = *head;
    *head = nuevo;
}

// Corrije lecturas negativas mediante paso por referencia
void corregir(float *lectura) {
    if (*lectura < 0.0f) {
        *lectura = 0.0f;
    }
}

// Captura de datos desde consola
void capturarEventoConsola(NodoEvento **head) {
    char sensor[30];
    float valor;
    char timestamp[25];

    printf("\n--- REGISTRAR NUEVO EVENTO ---\n");
    printf("Tipo de sensor: ");
    scanf(" %29[^\n]", sensor);
    
    printf("Valor medido: ");
    scanf("%f", &valor);
    
    // Saneamiento de lectura si fuera negativa
    corregir(&valor);

    printf("Marca de tiempo (YYYY-MM-DD HH:MM:SS): ");
    scanf(" %24[^\n]", timestamp);

    registrarEvento(head, sensor, valor, timestamp);
    printf(">> Evento registrado exitosamente.\n");
}

// Recorrido de la lista enlazada
void imprimirEventos(NodoEvento *head) {
    NodoEvento *p = head;
    if (p == NULL) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }
    
    printf("\n=== HISTORIAL DE EVENTOS: ESTACIÓN VIGÍA ===\n");
    while (p != NULL) {
        printf("[%s] Sensor: %-20s | Valor: %.2f\n", 
               p->evento.marcaTiempo, 
               p->evento.tipoSensor, 
               p->evento.valor);
        p = p->sig;
    }
}

// Búsqueda y filtrado por tipo de sensor
void buscarPorSensor(NodoEvento *head, const char *sensorBuscado) {
    NodoEvento *p = head;
    int encontrados = 0;
    
    printf("\n=== FILTRANDO POR SENSOR: %s ===\n", sensorBuscado);
    while (p != NULL) {
        if (strcmp(p->evento.tipoSensor, sensorBuscado) == 0) {
            printf("[%s] Valor: %.2f\n", p->evento.marcaTiempo, p->evento.valor);
            encontrados++;
        }
        p = p->sig;
    }
    
    if (encontrados == 0) {
        printf("No se encontraron registros para el sensor especificado.\n");
    }
}

/* 
 * CONCEPTOS SEMANA 7:
 * Cálculo de estadísticas (promedio, máximo, mínimo) utilizando punteros
 * para retornar los 3 valores por referencia a la función que la invoca.
 */
int calcularEstadisticas(NodoEvento *head, const char *sensorBuscado, float *promedio, float *max, float *min) {
    NodoEvento *p = head;
    float suma = 0.0f;
    int contador = 0;
    int primero = 1;

    while (p != NULL) {
        // Si sensorBuscado es NULL calcula para todos; si no, filtra por nombre
        if (sensorBuscado == NULL || strcmp(p->evento.tipoSensor, sensorBuscado) == 0) {
            float v = p->evento.valor;
            suma += v;

            if (primero) {
                *max = v;
                *min = v;
                primero = 0;
            } else {
                if (v > *max) *max = v;
                if (v < *min) *min = v;
            }
            contador++;
        }
        p = p->sig;
    }

    if (contador > 0) {
        *promedio = suma / contador;
    }

    return contador;
}

// Liberación de memoria dinámica
void liberarEventos(NodoEvento **head) {
    NodoEvento *p = *head;
    while (p != NULL) {
        NodoEvento *aux = p;
        p = p->sig;
        free(aux);
    }
    *head = NULL;
    printf("\nMemoria liberada correctamente.\n");
}

int main() {
    NodoEvento *historial = NULL;
    int opcion = 0;
    char sensorBusqueda[30];

    // Registros de prueba iniciales
    registrarEvento(&historial, "Temperatura", 24.5f, "2026-09-24 08:30:00");
    registrarEvento(&historial, "Humedad", 65.0f, "2026-09-24 08:35:00");
    registrarEvento(&historial, "Temperatura", 28.2f, "2026-09-24 09:00:00");
    registrarEvento(&historial, "Presion Atmosferica", 1013.25f, "2026-09-24 08:40:00");
    registrarEvento(&historial, "Temperatura", 21.0f, "2026-09-24 09:30:00");

    do {
        printf("\n====================================\n");
        printf("    SISTEMA ESTACIÓN VIGÍA - MENU\n");
        printf("====================================\n");
        printf("1. Registrar nuevo evento\n");
        printf("2. Mostrar historial completo\n");
        printf("3. Buscar por tipo de sensor\n");
        printf("4. Calcular estadísticas por sensor (Punteros)\n");
        printf("5. Salir\n");
        printf("Seleccione una opción: ");
        
        if (scanf("%d", &opcion) != 1) {
            while (getchar() != '\n');
            opcion = 0;
            continue;
        }

        switch (opcion) {
            case 1:
                capturarEventoConsola(&historial);
                break;
            case 2:
                imprimirEventos(historial);
                break;
            case 3:
                printf("\nIngrese el nombre del sensor a buscar: ");
                scanf(" %29[^\n]", sensorBusqueda);
                buscarPorSensor(historial, sensorBusqueda);
                break;
            case 4: {
                float prom = 0.0f, maxVal = 0.0f, minVal = 0.0f;
                printf("\nIngrese el nombre del sensor para estadísticas (o 'TODOS'): ");
                scanf(" %29[^\n]", sensorBusqueda);

                int total = 0;
                if (strcmp(sensorBusqueda, "TODOS") == 0 || strcmp(sensorBusqueda, "todos") == 0) {
                    total = calcularEstadisticas(historial, NULL, &prom, &maxVal, &minVal);
                } else {
                    total = calcularEstadisticas(historial, sensorBusqueda, &prom, &maxVal, &minVal);
                }

                if (total > 0) {
                    printf("\n=== ESTADÍSTICAS OBTENIDAS POR REFERENCIA ===\n");
                    printf("Muestras procesadas : %d\n", total);
                    printf("Promedio            : %.2f\n", prom);
                    printf("Valor Máximo        : %.2f\n", maxVal);
                    printf("Valor Mínimo        : %.2f\n", minVal);
                } else {
                    printf("\nNo hay datos para generar estadísticas del sensor especificado.\n");
                }
                break;
            }
            case 5:
                printf("\nSaliendo del programa...\n");
                break;
            default:
                printf("\nOpción no válida. Intente de nuevo.\n");
        }
    } while (opcion != 5);

    liberarEventos(&historial);

    return 0;
}
