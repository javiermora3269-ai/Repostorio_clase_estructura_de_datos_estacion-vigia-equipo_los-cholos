#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define UMBRAL_DEFECTO 25.0f // Umbral predeterminado para registro de eventos
#define TAM_BUFER 5          // Tamano fijo del bufer circular para sensores


// FASE 2: ESTRUCTURAS Y FUNCIONES PARA EL HISTORIAL DE EVENTOS (LISTA DOBLE)


// Estructura para un Nodo en la Lista Doblemente Enlazada
typedef struct NodoEvento {
    char tipoSensor[30];
    float valor;
    char marcaTiempo[25];   // Formato "YYYY-MM-DD HH:MM:SS"
    struct NodoEvento *ant; // Puntero al nodo anterior
    struct NodoEvento *sig; // Puntero al nodo siguiente
} NodoEvento;

// Estructura de control para la Lista Doblemente Enlazada de la Estacion Vigia
typedef struct ListaVigia {
    NodoEvento *cabeza; // Primer elemento
    NodoEvento *cola;   // Ultimo elemento
    int total;          // Cantidad actual de eventos almacenados
    float umbral;       // Umbral limite para disparo de registro
} ListaVigia;

// Crea e inicializa la lista doblemente enlazada
ListaVigia* crearLista(float umbralInicial) {
    ListaVigia *lista = (ListaVigia *)malloc(sizeof(ListaVigia));
    if (lista == NULL) {
        printf("Error: No se pudo asignar memoria para la estructura principal.\n");
        return NULL;
    }

    lista->cabeza = NULL;
    lista->cola = NULL;
    lista->total = 0;
    lista->umbral = umbralInicial;
    return lista;
}

// Inserta un nuevo evento al final de la lista si cruza/supera el umbral establecido
int registrarEventoConUmbral(ListaVigia *lista, const char *sensor, float valor, const char *timestamp) {
    if (lista == NULL) return 0;

    // Validacion de cruce de umbral
    if (valor < lista->umbral) {
        printf(">> [OMITIDO] El valor %.2f del sensor '%s' no supera el umbral configurado (%.2f).\n", 
               valor, sensor, lista->umbral);
        return 0;
    }

    NodoEvento *nuevo = (NodoEvento *)malloc(sizeof(NodoEvento));
    if (nuevo == NULL) {
        printf("Error: No se pudo asignar memoria para el nuevo evento.\n");
        return 0;
    }

    strncpy(nuevo->tipoSensor, sensor, sizeof(nuevo->tipoSensor) - 1);
    nuevo->tipoSensor[sizeof(nuevo->tipoSensor) - 1] = '\0';

    nuevo->valor = valor;

    strncpy(nuevo->marcaTiempo, timestamp, sizeof(nuevo->marcaTiempo) - 1);
    nuevo->marcaTiempo[sizeof(nuevo->marcaTiempo) - 1] = '\0';

    nuevo->sig = NULL;
    nuevo->ant = lista->cola;

    if (lista->cola != NULL) {
        lista->cola->sig = nuevo;
    } else {
        lista->cabeza = nuevo; // Era el primer nodo
    }

    lista->cola = nuevo;
    lista->total++;

    printf(">> [REGISTRADO] Evento registrado exitosamente al cruzar umbral >= %.2f.\n", lista->umbral);
    return 1;
}

// Corrije lecturas negativas mediante paso por referencia
void corregir(float *lectura) {
    if (*lectura < 0.0f) {
        *lectura = 0.0f;
    }
}

// Captura de datos desde consola
void capturarEventoConsola(ListaVigia *lista) {
    char sensor[30];
    float valor;
    char timestamp[25];

    printf("\n--- REGISTRAR NUEVO EVENTO (UMBRAL ACTUAL: %.2f) ---\n", lista->umbral);
    printf("Tipo de sensor: ");
    scanf(" %29[^\n]", sensor);

    printf("Valor medido: ");
    scanf("%f", &valor);

    // Saneamiento de lectura si fuera negativa
    corregir(&valor);

    printf("Marca de tiempo (YYYY-MM-DD HH:MM:SS): ");
    scanf(" %24[^\n]", timestamp);

    registrarEventoConUmbral(lista, sensor, valor, timestamp);
}

// Recorrido hacia adelante (cabeza -> cola)
void imprimirEventosAdelante(const ListaVigia *lista) {
    if (lista == NULL || lista->cabeza == NULL) {
        printf("\nEl historial de eventos esta vacio.\n");
        return;
    }

    printf("\n=== HISTORIAL DE EVENTOS (ADELANTE): ESTACION VIGIA (Total: %d) ===\n", lista->total);

    NodoEvento *actual = lista->cabeza;
    int idx = 1;
    while (actual != NULL) {
        printf("#%d [%s] Sensor: %-20s | Valor: %.2f\n",
               idx++, actual->marcaTiempo, actual->tipoSensor, actual->valor);
        actual = actual->sig;
    }
}

// Recorrido hacia atras (cola -> cabeza)
void imprimirEventosAtras(const ListaVigia *lista) {
    if (lista == NULL || lista->cola == NULL) {
        printf("\nEl historial de eventos esta vacio.\n");
        return;
    }

    printf("\n=== HISTORIAL DE EVENTOS (INVERSO): ESTACION VIGIA (Total: %d) ===\n", lista->total);

    NodoEvento *actual = lista->cola;
    int idx = lista->total;
    while (actual != NULL) {
        printf("#%d [%s] Sensor: %-20s | Valor: %.2f\n",
               idx--, actual->marcaTiempo, actual->tipoSensor, actual->valor);
        actual = actual->ant;
    }
}

// Busqueda y filtrado por tipo de sensor
void buscarPorSensor(const ListaVigia *lista, const char *sensorBuscado) {
    if (lista == NULL || lista->cabeza == NULL) {
        printf("\nEl historial de eventos esta vacio.\n");
        return;
    }

    int encontrados = 0;
    printf("\n=== FILTRANDO POR SENSOR: %s ===\n", sensorBuscado);

    NodoEvento *actual = lista->cabeza;
    while (actual != NULL) {
        if (strcmp(actual->tipoSensor, sensorBuscado) == 0) {
            printf("[%s] Valor: %.2f\n", actual->marcaTiempo, actual->valor);
            encontrados++;
        }
        actual = actual->sig;
    }

    if (encontrados == 0) {
        printf("No se encontraron registros para el sensor especificado.\n");
    }
}

// Elimina un evento de la lista por su numero de indice (1 a N)
int eliminarEventoPorIndice(ListaVigia *lista, int indice) {
    if (lista == NULL || lista->cabeza == NULL || indice < 1 || indice > lista->total) {
        printf("\nIndice no valido o lista vacia.\n");
        return 0;
    }

    NodoEvento *actual = lista->cabeza;
    for (int i = 1; i < indice; i++) {
        actual = actual->sig;
    }

    // Desconexion de los punteros
    if (actual->ant != NULL) {
        actual->ant->sig = actual->sig;
    } else {
        lista->cabeza = actual->sig; // Era el primer elemento
    }

    if (actual->sig != NULL) {
        actual->sig->ant = actual->ant;
    } else {
        lista->cola = actual->ant; // Era el ultimo elemento
    }

    printf("\n>> Evento #%d ('%s' con valor %.2f) eliminado con exito.\n", 
           indice, actual->tipoSensor, actual->valor);

    free(actual);
    lista->total--;
    return 1;
}

// Calculo de estadisticas mediante punteros por referencia
int calcularEstadisticas(const ListaVigia *lista, const char *sensorBuscado, float *promedio, float *max, float *min) {
    if (lista == NULL || lista->cabeza == NULL) return 0;

    float suma = 0.0f;
    int contador = 0;
    int primero = 1;

    NodoEvento *actual = lista->cabeza;
    while (actual != NULL) {
        if (sensorBuscado == NULL || strcmp(actual->tipoSensor, sensorBuscado) == 0) {
            float v = actual->valor;
            suma += v;

            if (primero) {
                *max = v;
                *min = v;
                primero = 0;
            } else {
                if (v > *max) *max = v;
                if (v < *min) *min = v;
            }
            contador++;
        }
        actual = actual->sig;
    }

    if (contador > 0) {
        *promedio = suma / contador;
    }

    return contador;
}

// Cambia el umbral de disparo del sistema
void cambiarUmbral(ListaVigia *lista) {
    if (lista == NULL) return;
    printf("\nIngrese el nuevo valor de umbral de disparo: ");
    scanf("%f", &lista->umbral);
    corregir(&lista->umbral);
    printf(">> Umbral actualizado a: %.2f\n", lista->umbral);
}

// Liberacion limpia de memoria de toda la lista
void liberarLista(ListaVigia **lista) {
    if (lista != NULL && *lista != NULL) {
        NodoEvento *actual = (*lista)->cabeza;
        while (actual != NULL) {
            NodoEvento *siguiente = actual->sig;
            free(actual);
            actual = siguiente;
        }
        free(*lista);
        *lista = NULL; // Evita puntero colgante
        printf("\nMemoria de la lista de eventos liberada correctamente.\n");
    }
}


// FASE 3: ESTRUCTURAS Y FUNCIONES PARA LA PILA DE DESHACER (LIFO) Y COLA DE COMANDOS (FIFO)


// Estructura de Comando de Motor/Actuador
typedef struct Comando {
    int idComando;
    char instruccion[50];
} Comando;

// Nodo para estructuras de comandos (utilizado por Pila y Cola)
typedef struct NodoComando {
    Comando cmd;
    struct NodoComando *sig;
} NodoComando;

// Estructura para la Pila de Deshacer (LIFO)
typedef struct {
    NodoComando *tope;
    int totalComandos;
} PilaDeshacer;

// Estructura para la Cola de Comandos (FIFO) - Semana 13
typedef struct {
    NodoComando *frente;
    NodoComando *final;
    int totalPendientes;
} ColaComandos;

// Inicializa la pila de comandos
PilaDeshacer* crearPila(void) {
    PilaDeshacer *pila = (PilaDeshacer *)malloc(sizeof(PilaDeshacer));
    if (pila == NULL) return NULL;
    pila->tope = NULL;
    pila->totalComandos = 0;
    return pila;
}

// Inicializa la cola de comandos (FIFO)
ColaComandos* crearCola(void) {
    ColaComandos *cola = (ColaComandos *)malloc(sizeof(ColaComandos));
    if (cola == NULL) return NULL;
    cola->frente = NULL;
    cola->final = NULL;
    cola->totalPendientes = 0;
    return cola;
}

int estaVaciaPila(const PilaDeshacer *pila) {
    return (pila == NULL || pila->tope == NULL);
}

int estaVaciaCola(const ColaComandos *cola) {
    return (cola == NULL || cola->frente == NULL);
}

// Encolar (Enqueue / FIFO): Agrega una instruccion al final de la cola de ejecucion
void encolarComando(ColaComandos *cola, int id, const char *instruccion) {
    if (cola == NULL) return;

    NodoComando *nuevo = (NodoComando *)malloc(sizeof(NodoComando));
    if (nuevo == NULL) {
        printf("Error: No se pudo asignar memoria para encolar el comando.\n");
        return;
    }

    nuevo->cmd.idComando = id;
    strncpy(nuevo->cmd.instruccion, instruccion, sizeof(nuevo->cmd.instruccion) - 1);
    nuevo->cmd.instruccion[sizeof(nuevo->cmd.instruccion) - 1] = '\0';
    nuevo->sig = NULL;

    if (cola->final == NULL) {
        cola->frente = nuevo;
        cola->final = nuevo;
    } else {
        cola->final->sig = nuevo;
        cola->final = nuevo;
    }
    cola->totalPendientes++;

    printf(">> [COLA FIFO] Comando #%d '%s' guardado en cola de espera (Pendientes: %d).\n", 
           id, instruccion, cola->totalPendientes);
}

// Apilar (Push / LIFO): Registra una accion ya ejecutada en la Pila de Deshacer
void apilarComando(PilaDeshacer *pila, Comando cmd) {
    if (pila == NULL) return;

    NodoComando *nuevo = (NodoComando *)malloc(sizeof(NodoComando));
    if (nuevo == NULL) {
        printf("Error de memoria al apilar el comando.\n");
        return;
    }

    nuevo->cmd = cmd;
    nuevo->sig = pila->tope;
    pila->tope = nuevo;
    pila->totalComandos++;

    printf(">> [HISTORIAL LIFO] Comando #%d '%s' registrado en Pila (Undo).\n", 
           cmd.idComando, cmd.instruccion);
}

// Desencolar y Ejecutar: Consume de la Cola FIFO y transfiere a la Pila LIFO (Fase 3 integrada)
int ejecutarSiguienteComando(ColaComandos *cola, PilaDeshacer *pila) {
    if (estaVaciaCola(cola)) {
        printf("\n[MOTOR] No hay comandos pendientes por ejecutar en la cola.\n");
        return 0;
    }

    NodoComando *temp = cola->frente;
    Comando cmdEjecutado = temp->cmd;

    cola->frente = cola->frente->sig;
    if (cola->frente == NULL) {
        cola->final = NULL;
    }
    free(temp);
    cola->totalPendientes--;

    printf("\n -> [MOTOR] Ejecutando comando FIFO: #%d '%s'\n", 
           cmdEjecutado.idComando, cmdEjecutado.instruccion);

    // Conecta con la Pila LIFO de deshacer
    apilarComando(pila, cmdEjecutado);
    return 1;
}

// Desapilar (Pop / Undo): Revierte la ultima accion ejecutada (LIFO)
int deshacerComando(PilaDeshacer *pila) {
    if (estaVaciaPila(pila)) {
        printf("\n[DESHACER] No hay comandos pendientes por revertir en la pila.\n");
        return 0;
    }

    NodoComando *temp = pila->tope;
    printf("\n <- [DESHACER (UNDO)] Revertida la accion #%d: '%s'\n", 
           temp->cmd.idComando, temp->cmd.instruccion);

    pila->tope = temp->sig;
    free(temp);
    pila->totalComandos--;
    return 1;
}

// Cima (Peek): Muestra la ultima accion ejecutada sin borrarla
void mostrarUltimoComando(const PilaDeshacer *pila) {
    if (estaVaciaPila(pila)) {
        printf("\nLa pila de comandos ejecutados esta vacia.\n");
        return;
    }
    printf("\n[CIMA PILA] Ultimo comando ejecutado: #%d - %s\n", 
           pila->tope->cmd.idComando, pila->tope->cmd.instruccion);
}

// Liberar memoria de la pila
void liberarPila(PilaDeshacer **pila) {
    if (pila != NULL && *pila != NULL) {
        while (!estaVaciaPila(*pila)) {
            deshacerComando(*pila);
        }
        free(*pila);
        *pila = NULL;
        printf("Memoria de la pila de comandos liberada correctamente.\n");
    }
}

// Liberar memoria de la cola
void liberarCola(ColaComandos **cola) {
    if (cola != NULL && *cola != NULL) {
        while (!estaVaciaCola(*cola)) {
            NodoComando *temp = (*cola)->frente;
            (*cola)->frente = (*cola)->frente->sig;
            free(temp);
        }
        free(*cola);
        *cola = NULL;
        printf("Memoria de la cola de comandos liberada correctamente.\n");
    }
}


// SEMANA 13: MODULO DE BUFER CIRCULAR DE LECTURAS CONTINUAS (SENSORES)


typedef struct {
    float buf[TAM_BUFER];
    int frente;
    int cuenta;
} BuferCircular;

void initBufer(BuferCircular *b) {
    b->frente = 0;
    b->cuenta = 0;
}

void encolarBufer(BuferCircular *b, float lectura) {
    int fin = (b->frente + b->cuenta) % TAM_BUFER; // Indice circular
    if (b->cuenta == TAM_BUFER) {
        // Bufer lleno: sobrescribe el dato mas antiguo en 'frente'
        b->buf[b->frente] = lectura;
        b->frente = (b->frente + 1) % TAM_BUFER;
    } else {
        b->buf[fin] = lectura;
        b->cuenta++;
    }
}

void simularBuferLecturas(void) {
    BuferCircular b;
    initBufer(&b);
    float lecturas[8] = {10.5f, 20.0f, 32.1f, 45.0f, 51.2f, 63.4f, 70.0f, 88.5f};

    printf("\n=== SIMULACION DE BUFER CIRCULAR DE SENSORES (N = %d) ===\n", TAM_BUFER);
    printf("Encolando 8 lecturas continuas para observar la sobrescritura:\n\n");

    for (int i = 0; i < 8; i++) {
        encolarBufer(&b, lecturas[i]);
        printf("Lectura %d (val: %5.1f) -> Arreglo: [", i + 1, lecturas[i]);
        for (int j = 0; j < TAM_BUFER; j++) {
            if (j < b.cuenta || b.cuenta == TAM_BUFER) printf("%5.1f", b.buf[j]);
            else printf("  _  ");
            if (j < TAM_BUFER - 1) printf(", ");
        }
        printf("] | Frente en pos: %d | Total: %d\n", b.frente, b.cuenta);
    }
    printf("\n");
}


// PROGRAMA PRINCIPAL CON MENU INTEGRADO


int main(void) {
    // Inicializacion del Historial de Eventos (Fase 2)
    ListaVigia *historial = crearLista(UMBRAL_DEFECTO);
    if (historial == NULL) return 1;

    // Inicializacion de la Pila de Deshacer y Cola de Comandos (Fase 3 / Semana 13)
    PilaDeshacer *pilaUndo = crearPila();
    ColaComandos *colaCmd = crearCola();

    if (pilaUndo == NULL || colaCmd == NULL) {
        liberarLista(&historial);
        liberarPila(&pilaUndo);
        liberarCola(&colaCmd);
        return 1;
    }

    int opcion = 0;
    int idComandoContador = 1;
    char sensorBusqueda[30];
    char instruccionActuador[50];

    // Registros iniciales de prueba (Fase 2)
    registrarEventoConUmbral(historial, "Temperatura", 24.5f, "2026-09-24 08:30:00");
    registrarEventoConUmbral(historial, "Humedad", 65.0f, "2026-09-24 08:35:00");
    registrarEventoConUmbral(historial, "Temperatura", 28.2f, "2026-09-24 09:00:00");
    registrarEventoConUmbral(historial, "Presion Atmosferica", 1013.25f, "2026-09-24 08:40:00");
    registrarEventoConUmbral(historial, "Temperatura", 21.0f, "2026-09-24 09:30:00");

    do {
        printf("\n========================================\n");
        printf("    SISTEMA ESTACION VIGIA - FASE 2 & 3   \n");
        printf("========================================\n");
        printf("1. Registrar nuevo evento (por umbral)\n");
        printf("2. Mostrar historial (Adelante)\n");
        printf("3. Mostrar historial (Inverso)\n");
        printf("4. Buscar por tipo de sensor\n");
        printf("5. Eliminar evento por indice\n");
        printf("6. Calcular estadisticas por sensor (Punteros)\n");
        printf("7. Cambiar umbral de disparo (Actual: %.2f)\n", historial->umbral);
        printf("----------------------------------------\n");
        printf("8.  [COLA FIFO] Encolar comando a actuador\n");
        printf("9.  [MOTOR] Ejecutar siguiente comando (FIFO -> LIFO)\n");
        printf("10. [DESHACER] Revertir ultimo comando (Pop LIFO)\n");
        printf("11. [PEEK] Ver ultimo comando ejecutado en cima\n");
        printf("----------------------------------------\n");
        printf("12. [SEMANA 13] Simular Bufer Circular de Sensores\n");
        printf("----------------------------------------\n");
        printf("13. Salir\n");
        printf("Seleccione una opcion: ");

        if (scanf("%d", &opcion) != 1) {
            while (getchar() != '\n');
            opcion = 0;
            continue;
        }

        switch (opcion) {
            case 1:
                capturarEventoConsola(historial);
                break;
            case 2:
                imprimirEventosAdelante(historial);
                break;
            case 3:
                imprimirEventosAtras(historial);
                break;
            case 4:
                printf("\nIngrese el nombre del sensor a buscar: ");
                scanf(" %29[^\n]", sensorBusqueda);
                buscarPorSensor(historial, sensorBusqueda);
                break;
            case 5: {
                imprimirEventosAdelante(historial);
                if (historial->total > 0) {
                    int idx;
                    printf("\nIngrese el numero de registro (#) a eliminar: ");
                    scanf("%d", &idx);
                    eliminarEventoPorIndice(historial, idx);
                }
                break;
            }
            case 6: {
                float prom = 0.0f, maxVal = 0.0f, minVal = 0.0f;
                printf("\nIngrese el nombre del sensor para estadisticas (o 'TODOS'): ");
                scanf(" %29[^\n]", sensorBusqueda);

                int total = 0;
                if (strcmp(sensorBusqueda, "TODOS") == 0 || strcmp(sensorBusqueda, "todos") == 0) {
                    total = calcularEstadisticas(historial, NULL, &prom, &maxVal, &minVal);
                } else {
                    total = calcularEstadisticas(historial, sensorBusqueda, &prom, &maxVal, &minVal);
                }

                if (total > 0) {
                    printf("\n=== ESTADISTICAS OBTENIDAS POR REFERENCIA ===\n");
                    printf("Muestras procesadas : %d\n", total);
                    printf("Promedio            : %.2f\n", prom);
                    printf("Valor Maximo        : %.2f\n", maxVal);
                    printf("Valor Minimo        : %.2f\n", minVal);
                } else {
                    printf("\nNo hay datos para generar estadisticas del sensor especificado.\n");
                }
                break;
            }
            case 7:
                cambiarUmbral(historial);
                break;
            case 8:
                printf("\nIngrese el comando/instruccion para el actuador (ej. 'AVANZAR', 'GIRAR_IZQ', 'DETENER'): ");
                scanf(" %49[^\n]", instruccionActuador);
                encolarComando(colaCmd, idComandoContador++, instruccionActuador);
                break;
            case 9:
                ejecutarSiguienteComando(colaCmd, pilaUndo);
                break;
            case 10:
                deshacerComando(pilaUndo);
                break;
            case 11:
                mostrarUltimoComando(pilaUndo);
                break;
            case 12:
                simularBuferLecturas();
                break;
            case 13:
                printf("\nSaliendo del programa Estacion Vigia...\n");
                break;
            default:
                printf("\nOpcion no valida. Intente de nuevo.\n");
        }
    } while (opcion != 13);

    // Liberacion completa de memoria de todas las estructuras
    liberarLista(&historial);
    liberarPila(&pilaUndo);
    liberarCola(&colaCmd);

    return 0;
}
