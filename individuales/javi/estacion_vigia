#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define UMBRAL_DEFECTO 25.0f // Umbral predeterminado para registro de eventos

// Estructura para un Nodo en la Lista Doblemente Enlazada
typedef struct NodoEvento {
    char tipoSensor[30];
    float valor;
    char marcaTiempo[25]; // Formato "YYYY-MM-DD HH:MM:SS"
    struct NodoEvento *ant; // Puntero al nodo anterior
    struct NodoEvento *sig; // Puntero al nodo siguiente
} NodoEvento;

// Estructura de control para la Lista Doblemente Enlazada de la Estación Vigía
typedef struct ListaVigia {
    NodoEvento *cabeza; // Primer elemento
    NodoEvento *cola;   // Último elemento
    int total;          // Cantidad actual de eventos almacenados
    float umbral;       // Umbral límite para disparo de registro
} ListaVigia;

// Crea e inicializa la lista doblemente enlazada
ListaVigia* crearLista(float umbralInicial) {
    ListaVigia *lista = (ListaVigia *)malloc(sizeof(ListaVigia));
    if (lista == NULL) {
        printf("Error: No se pudo asignar memoria para la estructura principal.\n");
        return NULL;
    }

    lista->cabeza = NULL;
    lista->cola = NULL;
    lista->total = 0;
    lista->umbral = umbralInicial;
    return lista;
}

// Inserta un nuevo evento al final de la lista si cruza/supera el umbral establecido
int registrarEventoConUmbral(ListaVigia *lista, const char *sensor, float valor, const char *timestamp) {
    if (lista == NULL) return 0;

    // Validación de cruce de umbral
    if (valor < lista->umbral) {
        printf(">> [OMITIDO] El valor %.2f del sensor '%s' no supera el umbral configurado (%.2f).\n", 
               valor, sensor, lista->umbral);
        return 0;
    }

    NodoEvento *nuevo = (NodoEvento *)malloc(sizeof(NodoEvento));
    if (nuevo == NULL) {
        printf("Error: No se pudo asignar memoria para el nuevo evento.\n");
        return 0;
    }

    strncpy(nuevo->tipoSensor, sensor, sizeof(nuevo->tipoSensor) - 1);
    nuevo->tipoSensor[sizeof(nuevo->tipoSensor) - 1] = '\0';

    nuevo->valor = valor;

    strncpy(nuevo->marcaTiempo, timestamp, sizeof(nuevo->marcaTiempo) - 1);
    nuevo->marcaTiempo[sizeof(nuevo->marcaTiempo) - 1] = '\0';

    nuevo->sig = NULL;
    nuevo->ant = lista->cola;

    if (lista->cola != NULL) {
        lista->cola->sig = nuevo;
    } else {
        lista->cabeza = nuevo; // Era el primer nodo
    }

    lista->cola = nuevo;
    lista->total++;

    printf(">> [REGISTRADO] Evento registrado exitosamente al cruzar umbral >= %.2f.\n", lista->umbral);
    return 1;
}

// Corrije lecturas negativas mediante paso por referencia
void corregir(float *lectura) {
    if (*lectura < 0.0f) {
        *lectura = 0.0f;
    }
}

// Captura de datos desde consola
void capturarEventoConsola(ListaVigia *lista) {
    char sensor[30];
    float valor;
    char timestamp[25];

    printf("\n--- REGISTRAR NUEVO EVENTO (UMBRAL ACTUAL: %.2f) ---\n", lista->umbral);
    printf("Tipo de sensor: ");
    scanf(" %29[^\n]", sensor);

    printf("Valor medido: ");
    scanf("%f", &valor);

    // Saneamiento de lectura si fuera negativa
    corregir(&valor);

    printf("Marca de tiempo (YYYY-MM-DD HH:MM:SS): ");
    scanf(" %24[^\n]", timestamp);

    registrarEventoConUmbral(lista, sensor, valor, timestamp);
}

// Recorrido hacia adelante (cabeza -> cola)
void imprimirEventosAdelante(const ListaVigia *lista) {
    if (lista == NULL || lista->cabeza == NULL) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }

    printf("\n=== HISTORIAL DE EVENTOS (ADELANTE): ESTACIÓN VIGÍA (Total: %d) ===\n", lista->total);

    NodoEvento *actual = lista->cabeza;
    int idx = 1;
    while (actual != NULL) {
        printf("#%d [%s] Sensor: %-20s | Valor: %.2f\n",
               idx++, actual->marcaTiempo, actual->tipoSensor, actual->valor);
        actual = actual->sig;
    }
}

// Recorrido hacia atrás (cola -> cabeza)
void imprimirEventosAtras(const ListaVigia *lista) {
    if (lista == NULL || lista->cola == NULL) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }

    printf("\n=== HISTORIAL DE EVENTOS (INVERSO): ESTACIÓN VIGÍA (Total: %d) ===\n", lista->total);

    NodoEvento *actual = lista->cola;
    int idx = lista->total;
    while (actual != NULL) {
        printf("#%d [%s] Sensor: %-20s | Valor: %.2f\n",
               idx--, actual->marcaTiempo, actual->tipoSensor, actual->valor);
        actual = actual->ant;
    }
}

// Búsqueda y filtrado por tipo de sensor
void buscarPorSensor(const ListaVigia *lista, const char *sensorBuscado) {
    if (lista == NULL || lista->cabeza == NULL) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }

    int encontrados = 0;
    printf("\n=== FILTRANDO POR SENSOR: %s ===\n", sensorBuscado);

    NodoEvento *actual = lista->cabeza;
    while (actual != NULL) {
        if (strcmp(actual->tipoSensor, sensorBuscado) == 0) {
            printf("[%s] Valor: %.2f\n", actual->marcaTiempo, actual->valor);
            encontrados++;
        }
        actual = actual->sig;
    }

    if (encontrados == 0) {
        printf("No se encontraron registros para el sensor especificado.\n");
    }
}

// Elimina un evento de la lista por su número de índice (1 a N)
int eliminarEventoPorIndice(ListaVigia *lista, int indice) {
    if (lista == NULL || lista->cabeza == NULL || indice < 1 || indice > lista->total) {
        printf("\nÍndice no válido o lista vacía.\n");
        return 0;
    }

    NodoEvento *actual = lista->cabeza;
    for (int i = 1; i < indice; i++) {
        actual = actual->sig;
    }

    // Desconexión de los punteros
    if (actual->ant != NULL) {
        actual->ant->sig = actual->sig;
    } else {
        lista->cabeza = actual->sig; // Era el primer elemento
    }

    if (actual->sig != NULL) {
        actual->sig->ant = actual->ant;
    } else {
        lista->cola = actual->ant; // Era el último elemento
    }

    printf("\n>> Evento #%d ('%s' con valor %.2f) eliminado con éxito.\n", 
           indice, actual->tipoSensor, actual->valor);

    free(actual);
    lista->total--;
    return 1;
}

// Cálculo de estadísticas mediante punteros por referencia
int calcularEstadisticas(const ListaVigia *lista, const char *sensorBuscado, float *promedio, float *max, float *min) {
    if (lista == NULL || lista->cabeza == NULL) return 0;

    float suma = 0.0f;
    int contador = 0;
    int primero = 1;

    NodoEvento *actual = lista->cabeza;
    while (actual != NULL) {
        if (sensorBuscado == NULL || strcmp(actual->tipoSensor, sensorBuscado) == 0) {
            float v = actual->valor;
            suma += v;

            if (primero) {
                *max = v;
                *min = v;
                primero = 0;
            } else {
                if (v > *max) *max = v;
                if (v < *min) *min = v;
            }
            contador++;
        }
        actual = actual->sig;
    }

    if (contador > 0) {
        *promedio = suma / contador;
    }

    return contador;
}

// Cambia el umbral de disparo del sistema
void cambiarUmbral(ListaVigia *lista) {
    if (lista == NULL) return;
    printf("\nIngrese el nuevo valor de umbral de disparo: ");
    scanf("%f", &lista->umbral);
    corregir(&lista->umbral);
    printf(">> Umbral actualizado a: %.2f\n", lista->umbral);
}

// Liberación limpia de memoria de toda la lista
void liberarLista(ListaVigia **lista) {
    if (lista != NULL && *lista != NULL) {
        NodoEvento *actual = (*lista)->cabeza;
        while (actual != NULL) {
            NodoEvento *siguiente = actual->sig;
            free(actual);
            actual = siguiente;
        }
        free(*lista);
        *lista = NULL; // Evita puntero colgante
        printf("\nMemoria de la lista liberada correctamente.\n");
    }
}

int main() {
    // Inicialización de la lista doblemente enlazada con umbral por defecto (25.0)
    ListaVigia *historial = crearLista(UMBRAL_DEFECTO);
    if (historial == NULL) {
        return 1;
    }

    int opcion = 0;
    char sensorBusqueda[30];

    // Registros de prueba (sólo se insertan aquellos que igualan o superan el umbral de 25.0)
    registrarEventoConUmbral(historial, "Temperatura", 24.5f, "2026-09-24 08:30:00"); // Omitido (< 25.0)
    registrarEventoConUmbral(historial, "Humedad", 65.0f, "2026-09-24 08:35:00");     // Registrado
    registrarEventoConUmbral(historial, "Temperatura", 28.2f, "2026-09-24 09:00:00"); // Registrado
    registrarEventoConUmbral(historial, "Presion Atmosferica", 1013.25f, "2026-09-24 08:40:00"); // Registrado
    registrarEventoConUmbral(historial, "Temperatura", 21.0f, "2026-09-24 09:30:00"); // Omitido (< 25.0)

    do {
        printf("\n========================================\n");
        printf("   SISTEMA ESTACIÓN VIGÍA - FASE 2      \n");
        printf("========================================\n");
        printf("1. Registrar nuevo evento (por umbral)\n");
        printf("2. Mostrar historial (Adelante)\n");
        printf("3. Mostrar historial (Inverso)\n");
        printf("4. Buscar por tipo de sensor\n");
        printf("5. Eliminar evento por índice\n");
        printf("6. Calcular estadísticas por sensor (Punteros)\n");
        printf("7. Cambiar umbral de disparo (Actual: %.2f)\n", historial->umbral);
        printf("8. Salir\n");
        printf("Seleccione una opción: ");

        if (scanf("%d", &opcion) != 1) {
            while (getchar() != '\n');
            opcion = 0;
            continue;
        }

        switch (opcion) {
            case 1:
                capturarEventoConsola(historial);
                break;
            case 2:
                imprimirEventosAdelante(historial);
                break;
            case 3:
                imprimirEventosAtras(historial);
                break;
            case 4:
                printf("\nIngrese el nombre del sensor a buscar: ");
                scanf(" %29[^\n]", sensorBusqueda);
                buscarPorSensor(historial, sensorBusqueda);
                break;
            case 5: {
                imprimirEventosAdelante(historial);
                if (historial->total > 0) {
                    int idx;
                    printf("\nIngrese el número de registro (#) a eliminar: ");
                    scanf("%d", &idx);
                    eliminarEventoPorIndice(historial, idx);
                }
                break;
            }
            case 6: {
                float prom = 0.0f, maxVal = 0.0f, minVal = 0.0f;
                printf("\nIngrese el nombre del sensor para estadísticas (o 'TODOS'): ");
                scanf(" %29[^\n]", sensorBusqueda);

                int total = 0;
                if (strcmp(sensorBusqueda, "TODOS") == 0 || strcmp(sensorBusqueda, "todos") == 0) {
                    total = calcularEstadisticas(historial, NULL, &prom, &maxVal, &minVal);
                } else {
                    total = calcularEstadisticas(historial, sensorBusqueda, &prom, &maxVal, &minVal);
                }

                if (total > 0) {
                    printf("\n=== ESTADÍSTICAS OBTENIDAS POR REFERENCIA ===\n");
                    printf("Muestras procesadas : %d\n", total);
                    printf("Promedio            : %.2f\n", prom);
                    printf("Valor Máximo        : %.2f\n", maxVal);
                    printf("Valor Mínimo        : %.2f\n", minVal);
                } else {
                    printf("\nNo hay datos para generar estadísticas del sensor especificado.\n");
                }
                break;
            }
            case 7:
                cambiarUmbral(historial);
                break;
            case 8:
                printf("\nSaliendo del programa...\n");
                break;
            default:
                printf("\nOpción no válida. Intente de nuevo.\n");
        }
    } while (opcion != 8);

    // Liberación completa de memoria
    liberarLista(&historial);

    return 0;
}
