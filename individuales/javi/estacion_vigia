#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define CAPACIDAD_INICIAL 2

// Estructura para un evento de sensor
typedef struct Evento {
    char tipoSensor[30];
    float valor;
    char marcaTiempo[25]; // Formato "YYYY-MM-DD HH:MM:SS"
} Evento;

// Estructura para el búfer dinámico de la Estación Vigía
typedef struct BuferVigia {
    Evento *eventos;   // Arreglo dinámico en memoria (heap)
    int capacidad;     // Capacidad máxima asignada actualmente
    int total;         // Cantidad actual de eventos almacenados
} BuferVigia;

// Reserva la memoria inicial para el búfer
BuferVigia* crearBufer(int capacidadInicial) {
    BuferVigia *bufer = (BuferVigia *)malloc(sizeof(BuferVigia));
    if (bufer == NULL) {
        printf("Error: No se pudo asignar memoria para la estructura principal.\n");
        return NULL;
    }

    bufer->eventos = (Evento *)malloc(capacidadInicial * sizeof(Evento));
    if (bufer->eventos == NULL) {
        printf("Error: No se pudo asignar memoria para el arreglo de eventos.\n");
        free(bufer);
        return NULL;
    }

    bufer->capacidad = capacidadInicial;
    bufer->total = 0;
    return bufer;
}

// Registra un evento y expande el búfer con realloc cuando se llena
int registrarEvento(BuferVigia *bufer, const char *sensor, float valor, const char *timestamp) {
    if (bufer == NULL || bufer->eventos == NULL) return 0;

    // Redimensionamiento dinámico cuando se alcanza la capacidad máxima
    if (bufer->total >= bufer->capacidad) {
        int nuevaCapacidad = bufer->capacidad * 2;
        Evento *temp = (Evento *)realloc(bufer->eventos, nuevaCapacidad * sizeof(Evento));
        
        if (temp == NULL) {
            printf("Error: No se pudo redimensionar la memoria del búfer.\n");
            return 0;
        }
        
        bufer->eventos = temp;
        bufer->capacidad = nuevaCapacidad;
        printf(">> [Memoria] Búfer expandido dinámicamente a capacidad: %d elementos.\n", bufer->capacidad);
    }

    Evento *nuevo = &bufer->eventos[bufer->total];

    strncpy(nuevo->tipoSensor, sensor, sizeof(nuevo->tipoSensor) - 1);
    nuevo->tipoSensor[sizeof(nuevo->tipoSensor) - 1] = '\0';

    nuevo->valor = valor;

    strncpy(nuevo->marcaTiempo, timestamp, sizeof(nuevo->marcaTiempo) - 1);
    nuevo->marcaTiempo[sizeof(nuevo->marcaTiempo) - 1] = '\0';

    bufer->total++;
    return 1;
}

// Corrije lecturas negativas mediante paso por referencia
void corregir(float *lectura) {
    if (*lectura < 0.0f) {
        *lectura = 0.0f;
    }
}

// Captura de datos desde consola
void capturarEventoConsola(BuferVigia *bufer) {
    char sensor[30];
    float valor;
    char timestamp[25];

    printf("\n--- REGISTRAR NUEVO EVENTO ---\n");
    printf("Tipo de sensor: ");
    scanf(" %29[^\n]", sensor);

    printf("Valor medido: ");
    scanf("%f", &valor);

    // Saneamiento de lectura si fuera negativa
    corregir(&valor);

    printf("Marca de tiempo (YYYY-MM-DD HH:MM:SS): ");
    scanf(" %24[^\n]", timestamp);

    if (registrarEvento(bufer, sensor, valor, timestamp)) {
        printf(">> Evento registrado exitosamente.\n");
    }
}

// Recorrido del búfer dinámico
void imprimirEventos(const BuferVigia *bufer) {
    if (bufer == NULL || bufer->total == 0) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }

    printf("\n=== HISTORIAL DE EVENTOS: ESTACIÓN VIGÍA (Registros: %d | Capacidad Búfer: %d) ===\n", 
           bufer->total, bufer->capacidad);

    for (int i = 0; i < bufer->total; i++) {
        printf("[%s] Sensor: %-20s | Valor: %.2f\n",
               bufer->eventos[i].marcaTiempo,
               bufer->eventos[i].tipoSensor,
               bufer->eventos[i].valor);
    }
}

// Búsqueda y filtrado por tipo de sensor
void buscarPorSensor(const BuferVigia *bufer, const char *sensorBuscado) {
    if (bufer == NULL || bufer->total == 0) {
        printf("\nEl historial de eventos está vacío.\n");
        return;
    }

    int encontrados = 0;
    printf("\n=== FILTRANDO POR SENSOR: %s ===\n", sensorBuscado);

    for (int i = 0; i < bufer->total; i++) {
        if (strcmp(bufer->eventos[i].tipoSensor, sensorBuscado) == 0) {
            printf("[%s] Valor: %.2f\n", bufer->eventos[i].marcaTiempo, bufer->eventos[i].valor);
            encontrados++;
        }
    }

    if (encontrados == 0) {
        printf("No se encontraron registros para el sensor especificado.\n");
    }
}

// Cálculo de estadísticas (promedio, máximo, mínimo) con retorno por referencia
int calcularEstadisticas(const BuferVigia *bufer, const char *sensorBuscado, float *promedio, float *max, float *min) {
    if (bufer == NULL || bufer->total == 0) return 0;

    float suma = 0.0f;
    int contador = 0;
    int primero = 1;

    for (int i = 0; i < bufer->total; i++) {
        if (sensorBuscado == NULL || strcmp(bufer->eventos[i].tipoSensor, sensorBuscado) == 0) {
            float v = bufer->eventos[i].valor;
            suma += v;

            if (primero) {
                *max = v;
                *min = v;
                primero = 0;
            } else {
                if (v > *max) *max = v;
                if (v < *min) *min = v;
            }
            contador++;
        }
    }

    if (contador > 0) {
        *promedio = suma / contador;
    }

    return contador;
}

// Liberación limpia de memoria para evitar fugas y punteros colgantes
void liberarBufer(BuferVigia **bufer) {
    if (bufer != NULL && *bufer != NULL) {
        if ((*bufer)->eventos != NULL) {
            free((*bufer)->eventos);
            (*bufer)->eventos = NULL; // Evita puntero colgante
        }
        free(*bufer);
        *bufer = NULL; // Evita puntero colgante
        printf("\nMemoria liberada correctamente.\n");
    }
}

int main() {
    // 1. Inicialización con capacidad inicial pequeña (2) para probar realloc automáticamente
    BuferVigia *historial = crearBufer(CAPACIDAD_INICIAL);
    if (historial == NULL) {
        return 1;
    }

    int opcion = 0;
    char sensorBusqueda[30];

    // Registros de prueba iniciales
    registrarEvento(historial, "Temperatura", 24.5f, "2026-09-24 08:30:00");
    registrarEvento(historial, "Humedad", 65.0f, "2026-09-24 08:35:00");
    registrarEvento(historial, "Temperatura", 28.2f, "2026-09-24 09:00:00");
    registrarEvento(historial, "Presion Atmosferica", 1013.25f, "2026-09-24 08:40:00");
    registrarEvento(historial, "Temperatura", 21.0f, "2026-09-24 09:30:00");

    do {
        printf("\n====================================\n");
        printf("    SISTEMA ESTACIÓN VIGÍA - MENU   \n");
        printf("====================================\n");
        printf("1. Registrar nuevo evento\n");
        printf("2. Mostrar historial completo\n");
        printf("3. Buscar por tipo de sensor\n");
        printf("4. Calcular estadísticas por sensor (Punteros)\n");
        printf("5. Salir\n");
        printf("Seleccione una opción: ");

        if (scanf("%d", &opcion) != 1) {
            while (getchar() != '\n');
            opcion = 0;
            continue;
        }

        switch (opcion) {
            case 1:
                capturarEventoConsola(historial);
                break;
            case 2:
                imprimirEventos(historial);
                break;
            case 3:
                printf("\nIngrese el nombre del sensor a buscar: ");
                scanf(" %29[^\n]", sensorBusqueda);
                buscarPorSensor(historial, sensorBusqueda);
                break;
            case 4: {
                float prom = 0.0f, maxVal = 0.0f, minVal = 0.0f;
                printf("\nIngrese el nombre del sensor para estadísticas (o 'TODOS'): ");
                scanf(" %29[^\n]", sensorBusqueda);

                int total = 0;
                if (strcmp(sensorBusqueda, "TODOS") == 0 || strcmp(sensorBusqueda, "todos") == 0) {
                    total = calcularEstadisticas(historial, NULL, &prom, &maxVal, &minVal);
                } else {
                    total = calcularEstadisticas(historial, sensorBusqueda, &prom, &maxVal, &minVal);
                }

                if (total > 0) {
                    printf("\n=== ESTADÍSTICAS OBTENIDAS POR REFERENCIA ===\n");
                    printf("Muestras procesadas : %d\n", total);
                    printf("Promedio            : %.2f\n", prom);
                    printf("Valor Máximo        : %.2f\n", maxVal);
                    printf("Valor Mínimo        : %.2f\n", minVal);
                } else {
                    printf("\nNo hay datos para generar estadísticas del sensor especificado.\n");
                }
                break;
            }
            case 5:
                printf("\nSaliendo del programa...\n");
                break;
            default:
                printf("\nOpción no válida. Intente de nuevo.\n");
        }
    } while (opcion != 5);

    // 2. Liberación limpia de memoria
    liberarBufer(&historial);

    return 0;
}
